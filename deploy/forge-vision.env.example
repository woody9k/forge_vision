# Copy to deploy/forge-vision.env and edit. That file is gitignored, so
# per-machine settings do not travel with the repo.
#
# Anything already exported in the environment wins over what is set here.

# Where captures, sites, components and logs live. Raw data is immutable and
# accumulates — put this on a volume you back up, not on a scratch disk.
#FORGE_VISION_DATA="$HOME/.forge-vision"

# Bind address. Default 127.0.0.1.
#
# There is NO authentication on this API, and it can key a transmitter. The
# SafetyController gates mistakes, not strangers. Only set this to 0.0.0.0 on
# a network you control, and read the exposure section of docs/DEPLOY.md
# first.
#FORGE_VISION_HOST=127.0.0.1

#FORGE_VISION_PORT=8347

# Interpreter to run under, if not the repo's .venv.
#FORGE_VISION_VENV="$HOME/Code/GPR/.venv"

# Seconds to wait for a clean shutdown before SIGKILL, and for the server to
# answer /api/status on start.
#FORGE_VISION_STOP_TIMEOUT=15
#FORGE_VISION_START_TIMEOUT=30
